# ────────────────────────────────────────────────────────────────────────────
# GitHub Profile Stats Generator — Local Development Environment
# ────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values below.
# NEVER commit your actual .env file (it is already in .gitignore).
# In GitHub Actions, these are provided automatically (GITHUB_TOKEN, GITHUB_ACTOR).
# ────────────────────────────────────────────────────────────────────────────

# ── Authentication ───────────────────────────────────────────────────────────
# PROFILE_STATS_TOKEN (optional but recommended)
# A Personal Access Token (PAT) from https://github.com/settings/tokens
# Required scopes: repo (for private stats), read:user
# If omitted, GITHUB_TOKEN must be set instead.
PROFILE_STATS_TOKEN=ghp_your_personal_access_token_here

# ── Identity ─────────────────────────────────────────────────────────────────
# Your GitHub username (required for local development)
# In GitHub Actions this is automatically set as GITHUB_ACTOR
GITHUB_USERNAME=your-github-username

# ── Output ───────────────────────────────────────────────────────────────────
# Directory where SVG files will be written (default: assets)
OUTPUT_DIR=assets
